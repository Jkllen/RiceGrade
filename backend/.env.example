# Must be an absolute file path on a persistent disk in deployment.
RICEGRADE_DB_PATH=/absolute/persistent/path/ricegrade.sqlite3
# If using the Cloudflare Pages Function same-origin proxy, CORS is not needed for the browser.
RICEGRADE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RICEGRADE_PUBLIC_URL=https://YOUR-PAGES-DOMAIN.pages.dev

# To enable actual forgot-password emails, supply credentials from your SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
